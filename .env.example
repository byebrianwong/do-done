# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PowerSync
POWERSYNC_URL=

# Google Calendar OAuth2
# Get from https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI for local dev:
#   http://localhost:3000/api/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Two-way calendar sync
# Shared secret between pg_cron (Supabase) and /api/calendar/worker. Generate a
# long random value and pass the SAME value to calendar_sync_configure() in SQL:
#   select calendar_sync_configure('https://your-app.example.com', '<this value>');
CALENDAR_CRON_SECRET=
# Public HTTPS base URL of the deployed web app. Used as the Google push webhook
# address AND as the OAuth issuer for the hosted MCP endpoint — it must be the
# URL clients actually reach, because Claude compares it against the metadata it
# discovered. Falls back to the request's forwarded host when unset, so leave it
# blank (or set it to http://localhost:3000) for local development.
APP_URL=

# MCP server
# Which user's tasks the LOCAL stdio server (apps/mcp) manages, and the user the
# optional static-token fallback below maps to. The hosted endpoint does NOT use
# this for OAuth callers — there the user comes from the access token.
DO_DONE_USER_ID=
# OPTIONAL static bearer for /api/mcp, as an alternative to the OAuth flow.
# Generate with `openssl rand -hex 32`. Useful for Claude Code, which can attach
# a header directly:
#   claude mcp add --transport http do-done <url> --header "Authorization: Bearer <token>"
# Claude's custom-connector UI cannot use this (it speaks OAuth only). Leave it
# blank to accept OAuth tokens exclusively.
MCP_BEARER_TOKEN=

# Next.js
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App ↔ site association (password-manager credential matching)
# Both are optional: when unset, the matching /.well-known route 404s and the
# mobile app still autofills — it just matches by bundle/package ID instead of
# by the dodone.byebrianwong.com website entry.
#
# "<AppleTeamID>.<bundleIdentifier>", e.g. ABCDE12345.com.beamer408.dodone
# Team ID: https://developer.apple.com/account → Membership details
APPLE_APP_ID=
# Comma-separated SHA-256 signing-certificate fingerprints for the Android app.
# Usually two: the EAS upload key (`eas credentials -p android`) and the Play
# app-signing key (Play Console → Release → Setup → App signing).
ANDROID_CERT_FINGERPRINTS=

# Mobile (Expo) env vars live in apps/mobile/.env — Expo loads env files from
# the app directory, not the monorepo root. See apps/mobile/.env.example.
