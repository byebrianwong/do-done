# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PowerSync
POWERSYNC_URL=

# Google Calendar OAuth2
# Get from https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI for local dev:
#   http://localhost:3000/api/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Two-way calendar sync
# Shared secret between pg_cron (Supabase) and /api/calendar/worker. Generate a
# long random value and pass the SAME value to calendar_sync_configure() in SQL:
#   select calendar_sync_configure('https://your-app.example.com', '<this value>');
CALENDAR_CRON_SECRET=
# Public HTTPS base URL of the deployed web app (used as the Google push webhook
# address). Optional locally; falls back to the worker request origin.
APP_URL=

# Next.js
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mobile (Expo) env vars live in apps/mobile/.env — Expo loads env files from
# the app directory, not the monorepo root. See apps/mobile/.env.example.
