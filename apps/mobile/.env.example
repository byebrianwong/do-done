# Copy to apps/mobile/.env — Expo CLI/Metro load env files from THIS directory,
# not the monorepo root. Only EXPO_PUBLIC_* vars reach the app bundle.

# Supabase (same project the web app uses)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Deployed DoDone web app. The mobile app calls its /api/calendar/events route
# (Bearer-authenticated with the Supabase session) to display Google Calendar
# events in Today/Upcoming. Optional: unset falls back to the production URL,
# so calendar events work in any build without configuration. Set it to point
# a build at a local or preview web app instead.
EXPO_PUBLIC_WEB_APP_URL=
