<!--
  The DoDone mark, from `widgets/dodone-mark.ts`. Same path, same stroke, on the
  same 100x100 canvas the glyph was authored on.

  The faded trailing copy the widget draws is dropped here on purpose: a
  complication icon renders at 24dp or less, where a 45%-opacity duplicate two
  strokes away reads as a smudge rather than as motion.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="100"
    android:viewportHeight="100"
    android:tint="?android:attr/colorControlNormal">
  <path
      android:pathData="M54.5,49.7A10.3,10.3 0 1 0 56.6,65.9L80.1,32.2"
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="11.2"
      android:strokeLineCap="round"
      android:strokeLineJoin="round" />
</vector>
