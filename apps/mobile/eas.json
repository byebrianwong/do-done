{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "wear-preview": {
      "extends": "preview",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":wear:assembleRelease"
      }
    },
    "wear-production": {
      "extends": "production",
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":wear:bundleRelease"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
